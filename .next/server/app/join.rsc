th":["children","join","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L9",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]]}],{"children":["__PAGE__",["$","$7","c",{"children":[["$","main",null,{"className":"flex min-h-screen flex-col","children":[["$","$La",null,{}],["$","div",null,{"className":"text-black min-w-full p-10 md:p-20 space-y-20","children":[["$","div",null,{"className":"space-y-8","children":[["$","h1",null,{"className":"text-center md:text-start text-2xl md:text-4xl tracking-wide __className_9c85b7","children":"OPPORTUNITIES"}],"$undefined",["$","div",null,{"className":"flex flex-col space-y-8 md:space-y-0 md:flex-row md:space-x-16","children":["$","div",null,{"className":"flex flex-col space-y-5 [&>*]:text-base md:[&>*]:text-xl [&>*]:leading-relaxed","children":[["$","p",null,{"children":"At Creative Labs, we have activities that all students can participate in!"}],["$","p",null,{"className":"font-bold md:pl-10","children":"(1) Workshops:"}],["$","p",null,{"className":" md:pl-20","children":"Anyone can attend workshops! We teach a variety of topics from basic design skills to illustrating. Follow our Instagram and Discord for the most recent updates!"}],["$","p",null,{"className":"font-bold md:pl-10","children":"(2) Events:"}],["$","p",null,{"className":"md:pl-20","children":"Anyone can also attend events! We sometimes invite famous people to talk about their passions or have companies talk about recruitment opportunities. Follow our Instagram and Discord for the most recent updates!"}],["$","p",null,{"className":"font-bold md:pl-10","children":"(3) Projects:"}],["$","p",null,{"className":"md:pl-20","children":"Students must apply to projects before the start of each quarter. Students can either be a Project Lead or Project Member. Together, everyone will work to complete a project by the end of the quarter. To see projects from past quarters, visit our Projects page."}]]}]}]]}],["$","div",null,{"className":"space-y-8","children":[["$","h1",null,{"className":"text-center md:text-start text-2xl md:text-4xl tracking-wide __className_9c85b7","children":"HOW DO WE OPERATE?"}],"$undefined",["$","div",null,{"className":"flex flex-col space-y-8 md:space-y-0 md:flex-row md:space-x-16","children":["$","div",null,{"className":"flex flex-col space-y-6 md:[&>*]:text-xl [&>*]:leading-relaxed","children":[["$","p",null,{"children":"Everyone is already part of the Creative Labs community! We also have various roles that students can apply to every quarter. Creative Labs has three main roles: Project Leads, Project Members, and Internal Board Members."}],["$","p",null,{"children":"Our first main component is the internal board. The internal board is responsible for running things behind the scenes like organizing events, socials, and workshops. Responsibilities and tasks vary depending on which team within the internal board you apply to. These teams include Design, Tech, Marketing/External, and Projects. In simpler terms, the Creative Labs community is managed by a small group of UCLA designers, developers, marketers, and project managers hoping to create cool and creative things together!"}],["$","p",null,{"children":"External projects consist of Project Leads and Project Members who work together to complete a project by the end of the quarter. Project Leads apply with a creative idea, and Project Members help that vision come true with their various skills."}]]}]}]]}],["$","div",null,{"className":"space-y-8","children":[["$","h1",null,{"className":"text-center false text-2xl md:text-4xl tracking-wide __className_9c85b7","children":"MAIN ROLES"}],"$undefined",["$","div",null,{"className":"flex flex-col space-y-8 md:space-y-0 md:flex-row md:space-x-16","children":["$","div",null,{"className":"flex flex-col md:flex-row items-start w-full md:space-x-12","children":[["$","div",null,{"className":"flex flex-col items-center w-full space-y-5 group undefined","children":[["$","img",null,{"src":"/card_icons/pink_thing_scaled.svg","className":"h-1/2 py-4 drop-shadow-lg group-hover:scale-125 transition ease-in-out delay-50 duration-300"}],["$","h1",null,{"className":"text-center text-2xl __className_9c85b7","children":"Project Lead"}],["$","p",null,{"className":"leading-relaxed text-center","children":"Have a cool idea? Apply to be a Project Lead and make it happen. We'll provide you the platform needed to recruit your dream team. Projects can be technical or non-technical! Past projects have ranged from a smart mirror to a fancy photoshoot."}]]}],["$","div",null,{"className":"flex flex-col items-center w-full space-y-5 group undefined","children":[["$","img",null,{"src":"/card_icons/purple_thing_scaled.svg","className":"h-1/2 py-4 drop-shadow-lg group-hover:scale-125 transition ease-in-out delay-50 duration-300"}],["$","h1",null,{"className":"text-center text-2xl __className_9c85b7","children":"Project Member"}],["$","p",null,{"className":"leading-relaxed text-center","children":"Want to be a part of something wonderful? Apply as a Project Member and collaborate with a Project Lead and other Project Members to create something awesome! Experience necessary varies! "}]]}],["$","div",null,{"className":"flex flex-col items-center w-full space-y-5 group undefined","children":[["$","img",null,{"src":"/card_icons/orange_thing_scaled.svg","className":"h-1/2 py-4 drop-shadow-lg group-hover:scale-125 transition ease-in-out delay-50 duration-300"}],["$","h1",null,{"className":"text-center text-2xl __className_9c85b7","children":"Board Member"}],["$","p",null,{"className":"leading-relaxed text-center","children":"We're always looking to grow our internal team! Help us run things behind the scenes like organizing events, socials, and workshops, communicating with Project Teams, securing funding, and creating promotional materials! "}]]}]]}]}]]}],["$","div",null,{"className":"space-y-8","children":[["$","h1",null,{"className":"text-center false text-4xl tracking-wide __className_9c85b7","children":"INTERNAL BOARD TEAMS"}],"$undefined",["$","div",null,{"className":"flex flex-col space-y-8 md:space-y-0 md:flex-row md:space-x-16","children":["$","div",null,{"className":"flex justify-center","children":["$","div",null,{"className":"content-center grid md:grid-cols-2 gap-12","children":[["$","div",null,{"className":"group space-y-4 ","children":[["$","div",null,{"className":"flex justify-center items-center space-x-4 rounded-xl drop-shadow-lg group-hover:scale-110 transition ease-in-out delay-50 duration-300 bg-red-100 group-hover:bg-red-200 ","children":[["$","img",null,{"src":"/card_icons/orange_thing.svg","className":"h-[100px] md:h-[100px] py-4 drop-shadow-xl"}],["$","h1",null,{"className":"text-2xl font-bold","children":"Design"}]]}],["$","p",null,{"className":"mx-4 tracking-wide leading-relaxed","children":"Help us strengthen our visual identity by creating cool design-y things! You can also learn and improve your skills in graphic design, web design, and UI/UX! Previous design work includes creating social media graphics, presentation slides, and wireframes for website redesigns and brainstorming new yearly themes and logos. We hosted events such as Figma workshops and design jams like Capslock!"}]]}],["$","div",null,{"className":"group space-y-4 ","children":[["$","div",null,{"className":"flex justify-center items-center space-x-4 rounded-xl drop-shadow-lg group-hover:scale-110 transition ease-in-out delay-50 duration-300 bg-green-100 group-hover:bg-green-200 ","children":[["$","img",null,{"src":"/card_icons/orange_thing.svg","className":"h-[100px] md:h-[100px] py-4 drop-shadow-xl"}],["$","h1",null,{"className":"text-2xl font-bold","children":"Tech"}]]}],["$","p",null,{"className":"mx-4 tracking-wide leading-relaxed","children":"Support our club infrastructure and work on long-term community projects! We are currently working on a membership platform, board management tools, a market platform, and MLOps projects. If you're interested in these, feel free to reach out!"}]]}],["$","div",null,{"className":"group space-y-4 ","children":[["$","div",null,{"className":"flex justify-center items-center space-x-4 rounded-xl drop-shadow-lg group-hover:scale-110 transition ease-in-out delay-50 duration-300 bg-blue-100 group-hover:bg-blue-200 flex-row-reverse space-x-reverse","children":[["$","img",null,{"src":"/card_icons/orange_thing.svg","className":"h-[100px] md:h-[100px] py-4 drop-shadow-xl"}],["$","h1",null,{"className":"text-2xl font-bold","children":"Marketing/External"}]]}],["$","p",null,{"className":"mx-4 tracking-wide leading-relaxed","children":"We help editing materials before they go out for public consumption! Some main tasks include copywriting,  creating a posting schedule, and reaching out to other clubs/businesses. Previous marketing/external work includes writing blurbs for social media, advertising events, and promoting our club!"}]]}],["$","div",null,{"className":"group space-y-4 ","children":[["$","div",null,{"className":"flex justify-center items-center space-x-4 rounded-xl drop-shadow-lg group-hover:scale-110 transition ease-in-out delay-50 duration-300 bg-yellow-100 group-hover:bg-yellow-200 flex-row-reverse space-x-reverse","children":[["$","img",null,{"src":"/card_icons/orange_thing.svg","className":"h-[100px] md:h-[100px] py-4 drop-shadow-xl"}],["$","h1",null,{"className":"text-2xl font-bold","children":"Projects"}]]}],["$","p",null,{"className":"mx-4 tracking-wide leading-relaxed","children":"Our main responsibility is hosting Creative Labs projects! Tasks include reaching out to projects teams, preparing for General Meetings and Demo Days, and compiling project info for documentation. In other words, you’ll be making sure that projects runs smoothly and stays on track by being the bridge between Project Leads and Project Members and the rest of the Internal Board!"}]]}]]}]}]